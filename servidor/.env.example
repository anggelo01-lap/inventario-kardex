# Inventario Kardex API — PostgreSQL
# Copia como .env y ajusta credenciales.

APP_NAME=Inventario Kardex API
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

SECRET_KEY=change_me_super_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Local:  postgresql+psycopg2://postgres:7721@localhost:5432/inventario_kardex
# Neon:   ver servidor/.env.neon.example
DATABASE_URL=postgresql+psycopg2://postgres:7721@localhost:5432/inventario_kardex

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=Admin12345
