# Inventario Kardex API — Neon (PostgreSQL en la nube)
# Copia como .env o pega DATABASE_URL en tu .env actual.

APP_NAME=Inventario Kardex API
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

SECRET_KEY=change_me_super_secret_key
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://inventario-kardex.vercel.app,https://inventario-kardex-k0bat6nn2-a44829753-4055s-projects.vercel.app

# Neon: Dashboard -> Connect -> Connection string
# Usa el driver SQLAlchemy (postgresql+psycopg2) y sslmode=require
#
# Ejemplo (reemplaza usuario, clave, host y nombre de base):
# DATABASE_URL=postgresql+psycopg2://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
#
# Recomendado para la app: endpoint "Pooled connection" (host con -pooler)
DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@ep-XXXX-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=Admin12345
